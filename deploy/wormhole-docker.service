# systemd unit that runs Wormhole as a Docker container service.
#
# Use this if you prefer the container image but want systemd to supervise it
# (start on boot, restart on failure) instead of Docker Compose.
#
# Install:
#   sudo cp deploy/wormhole-docker.service /etc/systemd/system/wormhole.service
#   sudo cp deploy/wormhole.env.example /etc/wormhole.env   # then edit
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wormhole

[Unit]
Description=Wormhole HTTP/HTTPS proxy (container)
Documentation=https://github.com/zollo/wormhole
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=3s
# Ensure a clean slate, then pull the image before starting. Note that :latest
# is a moving tag; pin a specific version or digest (e.g. :v1.2.3) for
# reproducible, predictable deployments.
ExecStartPre=-/usr/bin/docker rm -f wormhole
ExecStartPre=/usr/bin/docker pull ghcr.io/zollo/wormhole:latest
ExecStart=/usr/bin/docker run --rm --name wormhole \
    -p 8080:8080 \
    --env-file /etc/wormhole.env \
    --read-only \
    --security-opt no-new-privileges:true \
    ghcr.io/zollo/wormhole:latest
ExecStop=/usr/bin/docker stop wormhole

[Install]
WantedBy=multi-user.target
