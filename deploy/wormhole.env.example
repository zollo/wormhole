# Wormhole configuration — copy to /etc/wormhole.env and edit.
# Every setting has a matching command-line flag. These env vars act as the
# defaults; an explicitly passed flag overrides the corresponding variable.

# Address to listen on (host:port). Use 0.0.0.0:8080 to accept remote clients.
WORMHOLE_ADDR=:8080

# Basic authentication. Leave both empty to run an open proxy (only safe on a
# trusted / private network). Set both to require credentials.
WORMHOLE_USER=
WORMHOLE_PASS=

# Timeouts (Go duration syntax, e.g. 10s, 1m).
WORMHOLE_DIAL_TIMEOUT=10s
WORMHOLE_READ_TIMEOUT=30s
WORMHOLE_IDLE_TIMEOUT=120s

# Set to true for verbose debug logging.
WORMHOLE_VERBOSE=false
