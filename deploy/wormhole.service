# systemd unit for running Wormhole as a hardened background service.
#
# Install:
#   sudo cp wormhole /usr/local/bin/wormhole
#   sudo cp deploy/wormhole.service /etc/systemd/system/wormhole.service
#   sudo cp deploy/wormhole.env.example /etc/wormhole.env   # then edit
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin wormhole
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wormhole
#
# Configuration lives in /etc/wormhole.env (see wormhole.env.example).

[Unit]
Description=Wormhole HTTP/HTTPS forward proxy
Documentation=https://github.com/zollo/wormhole
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wormhole
Group=wormhole
EnvironmentFile=/etc/wormhole.env
ExecStart=/usr/local/bin/wormhole
Restart=on-failure
RestartSec=2s

# --- Security hardening ---
# Wormhole needs nothing but a network socket, so lock everything else down.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
# Allow binding to a privileged port (<1024) if configured to do so:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
